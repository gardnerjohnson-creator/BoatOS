# BoatOS Environment Configuration
# Copy this file to .env and fill in your values

# OpenWeatherMap API Key
# Get your free API key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Local development (see docs/development.md). Leave all of these unset on a
# Raspberry Pi installation — production behaviour is unchanged when unset.
# ---------------------------------------------------------------------------

# 1 = dev mode: Pi/systemd-only commands (systemctl, sudo, nmcli, pinctrl,
# shutdown/reboot, onboard keyboard, GPIO) are skipped and report "ok".
#BOATOS_DEV_MODE=1

# SignalK server base URL polled for GPS. Default: http://localhost:3000
# Set to an EMPTY value to disable SignalK polling entirely; GPS then comes
# from MQTT (boat/gps/*) or POST /api/gps/external (tools/fake_gps_track.py).
#BOATOS_SIGNALK_URL=

# MQTT broker used by the backend (default: localhost:1883)
#BOATOS_MQTT_HOST=localhost
#BOATOS_MQTT_PORT=1883
